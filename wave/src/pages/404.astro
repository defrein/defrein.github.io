---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { ArrowLeft } from '@lucide/svelte';
---
<Layout title="Page not found — Wahni Adnani">
  <section class="container not-found"><h1>A small detour.</h1><p>This page doesn't exist. Let's get back to the things I've built.</p><a class="button" href={withBase()}><ArrowLeft size={18} /> Back to the portfolio</a></section>
</Layout>
<style>.not-found { min-height: 65vh; display: flex; flex-direction: column; align-items: start; justify-content: center; padding-block: 4rem; } h1 { font-size: clamp(3rem, 7vw, 6rem); margin-bottom: 1.5rem; } p { color: var(--muted); max-width: 45ch; margin-bottom: 2rem; }</style>
