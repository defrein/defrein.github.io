---
import Layout from '../layouts/Layout.astro';
import ProjectGallery from '../components/ProjectGallery.svelte';
import ContactActions from '../components/ContactActions.svelte';
import { ArrowUpRight, ArrowDown, Download, MapPin, CodeXml, Cpu, BrainCircuit } from '@lucide/svelte';
import BrandIcon from '../components/BrandIcon.astro';
import { personal, resume, cvPath, projects, skillGroups } from '../data/portfolio';
import { withBase } from '../lib/paths';
---

<Layout home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">A little code.<br />A lot of<br /><span>possibility.</span></h1>
        <p>Hi, I'm <strong>Wahni Adnani.</strong> An AI & software engineer connecting intelligent software with the physical world.</p>
        <div class="hero-actions">
          <a class="button" href="#work">Explore my work <ArrowDown size={18} strokeWidth={1.8} /></a>
          <a class="text-link" href={withBase(cvPath)} download>Download CV <Download size={16} strokeWidth={1.8} /></a>
        </div>
      </div>
      <div class="hero-art" aria-label="A glimpse of my software and robotics work">
        <a class="hero-software" href={withBase('projects/jats-editor/')} aria-label="Explore JATS Editor">
          <div class="artifact-bar"><span><span class="artifact-dot"></span> JATS Editor</span><ArrowUpRight size={16} /></div>
          <div class="software-image"><img src={withBase(projects[0].image)} alt="JATS Editor scientific publishing interface" width="800" height="294" fetchpriority="high" /></div>
          <div class="artifact-caption"><span>Software, with a little intelligence.</span><CodeXml size={17} /></div>
        </a>
        <div class="art-label" aria-hidden="true"><span>From digital<br />to physical.</span><ArrowDown size={23} strokeWidth={1.5} /></div>
        <a class="hero-robot" href={withBase('projects/autonomous-robot-2024/')} aria-label="Explore Autonomous Robot">
          <img src={withBase(projects[1].image)} alt="Autonomous robot collecting colored balls on the KRI competition field" width="500" height="280" />
          <div class="robot-caption"><span>Built to move ideas forward.</span><ArrowUpRight size={17} /></div>
        </a>
        <div class="art-plus" aria-hidden="true">+</div>
      </div>
    </div>
    <div class="container hero-bottom"><span>Curiosity is where it starts. Building is how it happens.</span><a href="#work" aria-label="Scroll to selected work"><ArrowDown size={18} /></a></div>
  </section>

  <div class="disciplines container" aria-label="Explore my disciplines">
    <a href={withBase('?discipline=ai#work')} data-filter="ai"><BrainCircuit size={24} strokeWidth={1.5} /><span>AI & Machine Learning</span><ArrowUpRight size={18} /></a>
    <a href={withBase('?discipline=web#work')} data-filter="web"><CodeXml size={24} strokeWidth={1.5} /><span>Web & Software</span><ArrowUpRight size={18} /></a>
    <a href={withBase('?discipline=robotics#work')} data-filter="robotics"><Cpu size={24} strokeWidth={1.5} /><span>Robotics & IoT</span><ArrowUpRight size={18} /></a>
  </div>

  <section id="work" class="section work-section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading"><h2 id="work-title">Things I've built.</h2><p>Different challenges. The same curiosity.<br />A selection of work across code, data, and hardware.</p></div>
      <ProjectGallery client:load />
      <div class="work-close"><span>There's always something new on the workbench.</span><a class="text-link" href={`https://${personal.github}`} target="_blank" rel="noopener noreferrer">More on GitHub <ArrowUpRight size={17} /></a></div>
    </div>
  </section>

  <section id="about" class="section about-section" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-heading"><h2 id="about-title">An engineer.<br />A maker.<br /><span>Always curious.</span></h2><span class="location"><MapPin size={17} strokeWidth={1.7} /> {personal.location}</span></div>
      <div class="about-copy">
        <p class="about-lead">I like figuring out how things work.<br />And then making them work better.</p>
        <p>I'm Wahni, an AI and software engineer with {resume.stats.yearsExperience} years of experience building full-stack applications and intelligent systems. My work lives at the intersection of software, machine learning, and robotics.</p>
        <p>From helping scientific publishers work with complex documents to teaching robots to navigate a field, I enjoy turning tricky problems into useful, practical tools.</p>
        <p>Outside of day-to-day engineering, I keep exploring robotics, IoT, smart systems, and bioinformatics. There's always another question worth following.</p>
        <div class="about-links"><a class="text-link" href={`https://${personal.linkedin}`} target="_blank" rel="noopener noreferrer">Let's connect <ArrowUpRight size={17} /></a><a class="text-link" href={withBase(cvPath)} target="_blank" rel="noopener noreferrer">View my resume <ArrowUpRight size={17} /></a></div>
      </div>
    </div>
  </section>

  <section class="section skills-section" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-heading"><h2 id="skills-title">The tools behind the ideas.</h2><p>A practical toolkit.<br />Chosen for the problem, always learning.</p></div>
      <div class="skills-list">
        {skillGroups.map(group => <div class="skill-row"><div><h3>{group.title}</h3><p>{group.description}</p></div><ul class="skill-tags">{group.skills.map(skill => <li>{skill}</li>)}</ul></div>)}
      </div>
    </div>
  </section>

  <section id="experience" class="section experience-section" aria-labelledby="experience-title">
    <div class="container experience-grid">
      <div class="experience-heading"><h2 id="experience-title">Learning by<br />building.</h2><p>The people, places, and problems<br />that have shaped my work.</p><a class="text-link" href={withBase(cvPath)} download>Get the full resume <Download size={16} /></a></div>
      <div class="timeline">
        {resume.experience.map(job => <article class="job"><div class="job-time">{job.period}{job.current && <span class="current-label">Current</span>}</div><h3>{job.title}</h3><p class="job-company">{job.company}</p><p class="job-description">{'responsibilities' in job && job.responsibilities ? job.responsibilities[0] : 'Independent work across web applications, applied AI, and robotics, including national competition projects.'}</p><ul class="job-technologies">{('technologies' in job && job.technologies ? job.technologies : ['Web Development', 'Applied AI', 'Robotics']).map(tech => <li>{tech}</li>)}</ul></article>)}
      </div>
    </div>
    <div class="container education-grid"><h3>A foundation<br />to build on.</h3>{resume.education.map(education => <article class="education"><span>{education.period}</span><h4>{education.institution}</h4><p>{education.degree}</p><span class="gpa">GPA {education.gpa}</span></article>)}</div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div><h2 id="contact-title">Have a good problem?<br /><span>Let's build something.</span></h2><p>A project, an opportunity, or just a conversation.<br />I'd love to hear what you're thinking.</p><ContactActions email={personal.email} client:load /></div>
      <div class="contact-details"><a class="email-address" href={`mailto:${personal.email}`}>{personal.email}<ArrowUpRight size={23} /></a><div class="contact-socials"><a href={`https://${personal.github}`} target="_blank" rel="noopener noreferrer"><BrandIcon name="github" size={18} /> GitHub <ArrowUpRight size={15} /></a><a href={`https://${personal.linkedin}`} target="_blank" rel="noopener noreferrer"><BrandIcon name="linkedin" size={18} /> LinkedIn <ArrowUpRight size={15} /></a></div><p>Based in Banjarmasin, Indonesia.<br />Open to wherever a good idea takes us.</p></div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-filter]').forEach(link => {
    link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      history.replaceState(null, '', link.href);
      window.dispatchEvent(new CustomEvent('portfolio:filter', { detail: link.dataset.filter }));
      document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>

<style>
  .hero { background: var(--mint); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-top: clamp(3rem, 5.2vw, 5rem); padding-bottom: 3.5rem; align-items: center; }
  h1 { font-size: clamp(3rem, 5.6vw, 5.4rem); font-weight: 800; line-height: 1.035; margin-bottom: 1.8rem; }
  h1 span { color: var(--teal); }
  .hero-copy > p { color: #355c5b; max-width: 39ch; font-size: 1rem; line-height: 1.85; margin-bottom: 2rem; }
  .hero-copy strong { font-weight: 750; color: var(--petrol); }
  .hero-actions { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; }
  .hero-art { position: relative; min-width: 0; height: 440px; }
  .hero-software { display: block; background: var(--white); width: 94%; position: absolute; top: 0; left: 0; border: 1px solid #bad6d1; transform: rotate(-3deg); transition: transform 300ms var(--ease); }
  .hero-software:hover { transform: rotate(-1deg) translateY(-3px); }
  .artifact-bar { display: flex; align-items: center; justify-content: space-between; padding: .85rem 1rem; font-size: .72rem; font-weight: 700; border-bottom: 1px solid var(--line); }
  .artifact-bar > span { display: flex; align-items: center; gap: .5rem; }
  .artifact-dot { width: 7px; height: 7px; background: var(--teal); border-radius: 50%; }
  .software-image { padding: .9rem .5rem; background: #f1f7f5; }
  .software-image img { aspect-ratio: 2.72; object-fit: contain; width: 100%; height: auto; }
  .artifact-caption { display: flex; align-items: center; justify-content: space-between; padding: .8rem 1rem; font-size: .66rem; }
  .hero-robot { display: block; background: var(--petrol); color: white; position: absolute; width: 67%; right: -1%; bottom: 0; transform: rotate(4deg); transition: transform 300ms var(--ease); }
  .hero-robot:hover { transform: rotate(2deg) translateY(-3px); }
  .hero-robot > img { width: 100%; aspect-ratio: 1.9; height: auto; object-fit: cover; }
  .robot-caption { display: flex; justify-content: space-between; align-items: center; font-size: .64rem; padding: .85rem; }
  .art-label { position: absolute; bottom: 2.8rem; left: 0; display: flex; flex-direction: column; gap: 1rem; font-size: .83rem; line-height: 1.5; color: var(--teal); font-weight: 650; }
  .art-plus { position: absolute; bottom: 11.4rem; right: -1rem; width: 44px; height: 44px; background: var(--orange); display: grid; place-items: center; border-radius: 50%; font-weight: 500; font-size: 2rem; line-height: 1; }
  .hero-bottom { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #b7d6cf; min-height: 58px; font-size: .67rem; color: #3a6260; }
  .hero-bottom a { min-width: 44px; min-height: 44px; display: grid; place-items: center; }
  .disciplines { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); padding-block: 1.65rem; }
  .disciplines > a { display: flex; align-items: center; gap: .85rem; min-height: 44px; padding-inline: 1.5rem; border-right: 1px solid var(--line); font-weight: 650; font-size: .84rem; }
  .disciplines > a:first-child { padding-left: 0; }
  .disciplines > a:last-child { border: 0; padding-right: 0; }
  .disciplines > a > :last-child { margin-left: auto; flex-shrink: 0; }
  .disciplines > a:hover { color: var(--teal); }
  .work-close { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: .75rem; color: var(--muted); }
  .about-section { background: var(--mint-light); }
  .about-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 5rem; }
  .about-heading h2 { line-height: 1.16; }
  .about-heading h2 span { color: var(--teal); }
  .location { display: inline-flex; align-items: center; gap: .5rem; font-size: .75rem; color: var(--muted); margin-top: .8rem; }
  .about-copy > p { color: var(--muted); font-size: .9rem; line-height: 1.9; max-width: 65ch; margin-bottom: 1.1rem; }
  .about-copy > p.about-lead { font-size: 1.3rem; font-weight: 650; color: var(--petrol); line-height: 1.5; margin-bottom: 1.5rem; letter-spacing: -.025em; }
  .about-links { display: flex; gap: 2rem; flex-wrap: wrap; padding-top: .5rem; }
  .skills-list { border-top: 1px solid var(--line); }
  .skill-row { display: grid; grid-template-columns: .9fr 1.1fr; gap: 5rem; border-bottom: 1px solid var(--line); padding-block: 2rem; }
  .skill-row h3 { font-size: 1.1rem; margin-bottom: .65rem; }
  .skill-row p { font-size: .8rem; max-width: 36ch; color: var(--muted); margin: 0; }
  .skill-tags { display: flex; flex-wrap: wrap; align-content: start; gap: .5rem; list-style: none; padding: 0; margin: 0; }
  .skill-tags li { padding: .4rem .7rem; border: 1px solid var(--line); font-size: .72rem; border-radius: 3px; }
  .experience-section { background: #f2f4ec; }
  .experience-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 5rem; }
  .experience-heading > p { color: var(--muted); font-size: .88rem; line-height: 1.8; margin-bottom: 1.5rem; }
  .job { padding-bottom: 2.2rem; margin-bottom: 2rem; border-bottom: 1px solid #d3dacb; }
  .job:last-child { margin-bottom: 0; }
  .job-time { font-size: .7rem; color: var(--muted); display: flex; align-items: center; justify-content: space-between; gap: .75rem; font-variant-numeric: tabular-nums; margin-bottom: .8rem; }
  .current-label { padding: .15rem .5rem; font-size: .6rem; background: #d4e6d9; color: #275439; border-radius: 2px; }
  .job h3 { font-size: 1.3rem; margin-bottom: .4rem; }
  .job-company { color: var(--teal); font-size: .8rem; font-weight: 650; margin-bottom: 1rem; }
  .job-description { font-size: .82rem; color: var(--muted); line-height: 1.85; }
  .job-technologies { display: flex; flex-wrap: wrap; gap: .5rem 1rem; list-style: none; margin: .8rem 0 0; padding: 0; font-size: .65rem; color: #4e645d; }
  .education-grid { display: grid; grid-template-columns: .9fr 1.1fr 1.1fr; gap: 3rem; margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid #d3dacb; }
  .education-grid > h3 { font-size: 1.35rem; line-height: 1.35; }
  .education > span { color: var(--muted); font-size: .7rem; }
  .education h4 { font-size: .93rem; margin-block: .65rem .4rem; }
  .education p { font-size: .78rem; color: var(--muted); margin-bottom: .5rem; }
  .education > span.gpa { color: var(--teal); font-size: .7rem; font-weight: 650; }
  .contact-section { background: var(--teal); color: white; padding-top: clamp(4rem, 7vw, 6.5rem); padding-bottom: clamp(3rem, 6vw, 5rem); }
  .contact-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: center; }
  .contact-grid h2 { font-size: clamp(1.9rem, 3.3vw, 3rem); margin-bottom: 1.5rem; line-height: 1.2; }
  .contact-grid h2 span { color: var(--mint); }
  .contact-grid > div > p { color: #cbe4e1; font-size: .86rem; line-height: 1.85; margin-bottom: 1.7rem; }
  .contact-section :global(:focus-visible) { outline-color: #ffd3a2; }
  .email-address { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; overflow-wrap: anywhere; gap: .75rem; border-bottom: 1px solid #70a5a4; padding-bottom: 1.3rem; font-size: clamp(.9rem, 1.55vw, 1.35rem); font-weight: 650; letter-spacing: -.02em; }
  .email-address:hover { color: var(--mint); }
  .contact-socials { display: flex; gap: 1.8rem; margin-block: 1.2rem 1.5rem; }
  .contact-socials a { display: flex; align-items: center; gap: .5rem; font-size: .75rem; min-height: 44px; }
  .contact-socials a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .contact-grid .contact-details p { font-size: .75rem; margin-bottom: 0; }
  @media (min-width: 1440px) { .hero-art { height: 470px; } }
  @media (max-width: 1000px) { .artifact-caption { display: none; } }
  @media (max-width: 1000px) and (min-width: 701px) {
    .hero-grid { gap: 1.5rem; }
    .hero-art { height: 380px; }
    .hero-software { top: 1rem; }
    .hero-robot { width: 76%; }
    .art-label { bottom: 0; font-size: .7rem; }
    .disciplines > a { padding-inline: 1rem; gap: .5rem; font-size: .7rem; }
    .about-grid, .skill-row, .experience-grid { gap: 3rem; }
    .contact-grid { gap: 2rem; }
  }
  @media (max-width: 700px) {
    .hero-grid { grid-template-columns: 1fr; padding-top: 3rem; padding-bottom: 2rem; gap: 3rem; }
    h1 { font-size: clamp(2.9rem, 11vw, 4.5rem); margin-bottom: 1.5rem; }
    .hero-copy > p { max-width: 40ch; font-size: .9rem; }
    .hero-actions { gap: .75rem 1.25rem; }
    .hero-art { height: clamp(310px, 88vw, 440px); width: calc(100% - .5rem); }
    .hero-software { width: 94%; }
    .hero-robot { width: 68%; }
    .art-label { bottom: 1.4rem; font-size: .75rem; }
    .art-plus { right: -.5rem; bottom: 9.8rem; }
    .hero-bottom { gap: 1rem; font-size: .6rem; }
    .hero-bottom > span { max-width: 34ch; }
    .disciplines { grid-template-columns: 1fr; padding-block: .7rem; }
    .disciplines > a, .disciplines > a:first-child, .disciplines > a:last-child { padding: .9rem 0; border-right: 0; border-bottom: 1px solid var(--line); font-size: .8rem; }
    .disciplines > a:last-child { border-bottom: 0; }
    .disciplines > a > svg { width: 20px; }
    .work-close { align-items: start; flex-direction: column; gap: .4rem; margin-top: 2.5rem; }
    .about-grid, .skill-row, .experience-grid, .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-heading h2 { margin-bottom: 1rem; }
    .about-copy > p.about-lead { font-size: 1.15rem; }
    .skill-row { gap: 1.2rem; padding-block: 1.8rem; }
    .experience-grid { gap: 2.5rem; }
    .experience-heading > p br { display: none; }
    .experience-heading h2 br { display: none; }
    .education-grid { grid-template-columns: 1fr; gap: 1.75rem; margin-top: 2.5rem; }
    .education-grid > h3 { margin-bottom: 0; }
    .education-grid > h3 br { display: none; }
    .contact-grid { gap: 2.2rem; }
    .email-address { font-size: 1rem; }
    .contact-socials { margin-block: 1rem; }
  }
</style>
