---
import Layout from '../../layouts/Layout.astro';
import { projects, personal } from '../../data/portfolio';
import { withBase } from '../../lib/paths';
import { ArrowLeft, ArrowUpRight, ArrowRight } from '@lucide/svelte';

export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
---

<Layout title={`${project.title} — Wahni Adnani`} description={project.summary}>
  <section class="project-intro container">
    <a class="text-link back-link" href={withBase('#work')}><ArrowLeft size={17} /> Back to all work</a>
    <div class="intro-row"><h1>{project.title}</h1>{project.link && <a class="button" href={project.link} target="_blank" rel="noopener noreferrer">Visit website <ArrowUpRight size={18} /></a>}</div>
    <p class="project-subtitle">{project.subtitle}</p>
    <div class:list={['project-cover', project.color, { photo: project.isPhoto }]}><img src={withBase(project.image)} alt={`${project.title} — ${project.slug.includes('robot') ? 'robot on the competition field' : 'application interface'}`} width="1280" height="720" fetchpriority="high" /></div>
  </section>
  <section class="container project-story">
    <aside><h2>Made with</h2><ul class="technologies">{project.technologies.map(tech => <li>{tech}</li>)}</ul><a class="text-link" href={`mailto:${personal.email}?subject=${encodeURIComponent(`Let's talk about ${project.title}`)}`}>Talk about this project <ArrowUpRight size={16} /></a></aside>
    <div class="story-copy"><h2>The idea</h2><p>{project.context}</p><h2>The work</h2><ul>{project.contributions.map(item => <li>{item}</li>)}</ul><p class="project-source">Part of my work across AI, software engineering, and robotics.</p></div>
  </section>
  <div class="container next-project"><div><p>Keep exploring</p><h2><a href={withBase(`projects/${next.slug}/`)}>{next.title}</a></h2></div><a class="next-arrow" href={withBase(`projects/${next.slug}/`)} aria-label={`Next project: ${next.title}`}><ArrowRight size={30} strokeWidth={1.5} /></a></div>
</Layout>

<style>
  .project-intro { padding-top: 2.5rem; }
  .back-link { color: var(--muted); font-size: .75rem; margin-bottom: 2rem; }
  .intro-row { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  h1 { font-size: clamp(2.4rem, 5vw, 4.8rem); margin-bottom: 1rem; max-width: 17ch; }
  .intro-row .button { flex-shrink: 0; }
  .project-subtitle { color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.3rem); margin-bottom: 2.5rem; }
  .project-cover { padding: clamp(1.25rem, 4vw, 4rem); }
  .project-cover img { width: 100%; height: auto; max-height: 650px; object-fit: contain; margin-inline: auto; }
  .project-cover.photo { padding: 0; }
  .project-cover.photo img { object-fit: cover; max-height: 620px; }
  .project-story { display: grid; grid-template-columns: 1fr 2fr; gap: 6rem; padding-block: 4rem 5rem; }
  .project-story h2 { font-size: 1.5rem; margin-bottom: 1.2rem; }
  .technologies { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .technologies li { padding: .35rem .65rem; border: 1px solid var(--line); font-size: .7rem; border-radius: 3px; }
  .story-copy > p, .story-copy > ul { color: var(--muted); font-size: .92rem; line-height: 1.95; max-width: 65ch; }
  .story-copy h2:not(:first-child) { margin-top: 2.4rem; }
  .story-copy > ul { padding-left: 1.2rem; }
  .story-copy li { padding-left: .4rem; margin-bottom: .65rem; }
  .story-copy .project-source { margin-top: 2rem; font-size: .75rem; }
  .next-project { border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 3rem 4rem; }
  .next-project p { color: var(--muted); font-size: .75rem; margin-bottom: .7rem; }
  .next-project h2 { font-size: clamp(1.6rem, 3vw, 2.5rem); margin-bottom: 0; }
  .next-project h2 a:hover { color: var(--purple-strong); }
  .next-arrow { flex-shrink: 0; background: var(--surface-cyan); padding: 1rem; }
  .next-arrow:hover { background: var(--purple-strong); color: white; }
  @media (max-width: 700px) {
    .project-intro { padding-top: 1.5rem; }
    .back-link { margin-bottom: 1.5rem; }
    .intro-row { flex-direction: column; align-items: start; gap: .5rem; }
    .intro-row .button { margin-bottom: 1rem; }
    .project-subtitle { margin-bottom: 1.75rem; }
    .project-story { grid-template-columns: 1fr; gap: 2.5rem; padding-block: 3rem; }
    .project-story aside { order: 2; border-top: 1px solid var(--line); padding-top: 2rem; }
    .next-project { padding-block: 2rem 3rem; }
  }
</style>
