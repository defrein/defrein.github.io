---
import BlogListing from '../../components/BlogListing.astro';
import { getBlogPosts } from '../../lib/blog';
import { BLOG_POSTS_PER_PAGE, pageSlice } from '../../lib/pagination';

const posts = await getBlogPosts();
---

<BlogListing posts={pageSlice(posts, 1, BLOG_POSTS_PER_PAGE)} total={posts.length} />
